<Window x:Class="Portfolio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Portfolio" Height="600" Width="800" Background="#f3f4f6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1f2937" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Umair Mohammeth" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,20,0"/>
                <TextBlock Text="Software Developer &amp; Designer" Foreground="#9ca3af" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="40">
                <!-- About Section -->
                <TextBlock Text="About Me" FontSize="22" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                <TextBlock Text="Welcome to my portfolio! I am passionate about building modern, responsive, and beautiful applications. Here are some of my recent projects." 
                           TextWrapping="Wrap" Foreground="#4b5563" FontSize="16" Margin="0,0,0,30"/>

                <!-- Projects Section -->
                <TextBlock Text="My Projects" FontSize="22" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,15"/>
                
                <WrapPanel>
                    <!-- Project Card 1 -->
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,20,20" Width="300">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Project 1" FontSize="18" FontWeight="Bold" Foreground="#1f2937" Margin="0,0,0,10"/>
                            <TextBlock Text="A brief description of this project and the technologies used." TextWrapping="Wrap" Foreground="#6b7280" Margin="0,0,0,15"/>
                            <Button Content="View Project" Background="#3b82f6" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Project Card 2 -->
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,20,20" Width="300">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Project 2" FontSize="18" FontWeight="Bold" Foreground="#1f2937" Margin="0,0,0,10"/>
                            <TextBlock Text="A brief description of this project and the technologies used." TextWrapping="Wrap" Foreground="#6b7280" Margin="0,0,0,15"/>
                            <Button Content="View Project" Background="#3b82f6" Foreground="White" Padding="10,5" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
