{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "bg-black", "color": "#06070D", "name": "BG Black" },
        { "slug": "bg-deep", "color": "#0A0C16", "name": "BG Deep" },
        { "slug": "text-white", "color": "#F2F3FA", "name": "Text White" },
        { "slug": "text-muted", "color": "#9AA0B8", "name": "Text Muted" },
        { "slug": "gold", "color": "#D4AF37", "name": "Gold" },
        { "slug": "gold-light", "color": "#F5D76E", "name": "Gold Light" },
        { "slug": "cyan", "color": "#00D4FF", "name": "Cyan" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "sans", "fontFamily": "'Outfit', sans-serif", "name": "Outfit" },
        { "slug": "mono", "fontFamily": "'JetBrains Mono', monospace", "name": "JetBrains Mono" }
      ]
    },
    "layout": { "contentSize": "800px", "wideSize": "1240px" },
    "spacing": { "units": ["px", "em", "rem", "%"] }
  },
  "styles": {
    "color": { "background": "var(--bg-black)", "text": "var(--text-white)" },
    "typography": { "fontFamily": "var(--font-sans)" }
  }
}
